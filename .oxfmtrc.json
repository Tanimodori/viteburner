{
  "printWidth": 120,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "proseWrap": "never",
  "htmlWhitespaceSensitivity": "ignore",
  "vueIndentScriptAndStyle": true,
  "endOfLine": "crlf",
  "sortPackageJson": false,
  "sortImports": {
    "groups": ["builtin", "external", ["internal", "subpath"], ["parent", "sibling", "index"], "style", "unknown"],
    "internalPattern": ["@/", "#"],
    "newlinesBetween": false
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/NetscriptDefinitions.d.ts",
    "package-lock.json",
    "bin/**",
    "e2e/.cache/**",
    "e2e/.tmp/**"
  ]
}
