{
  "printWidth": 120,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "proseWrap": "never",
  "htmlWhitespaceSensitivity": "ignore",
  "vueIndentScriptAndStyle": true,
  "endOfLine": "crlf",
  "sortPackageJson": false,
  "sortImports": {
    "groups": ["builtin", "external", ["internal", "subpath"], ["parent", "sibling", "index"], "style", "unknown"],
    "internalPattern": ["@/", "#"],
    "newlinesBetween": false
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/.rush/**",
    "**/NetscriptDefinitions.d.ts",
    "package-lock.json",
    "**/bin/**",
    "**/test/.cache/**",
    "**/test/.tmp/**",
    // These are Rush's own files rather than ours: the install-run scripts under common/scripts are
    // generated and rewritten by rush, and repo-state.json is rewritten by every "rush update" with
    // LF, so checking them only ever reports churn we would have to redo. CHANGELOG.json/CHANGELOG.md
    // are rewritten by "rush publish --apply" in a format oxfmt would immediately change (no blank
    // line between a version heading and its date), so leave them alone as well.
    "common/scripts/**",
    "common/config/rush/repo-state.json",
    "**/CHANGELOG.json",
    "**/CHANGELOG.md"
  ]
}
