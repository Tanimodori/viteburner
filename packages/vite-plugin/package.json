{
  "name": "@viteburner/vite-plugin",
  "version": "0.5.3",
  "description": "Vite plugin syncing Bitburner scripts: transform, upload, download, and RAM monitoring.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/typings/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "typings": "dist/typings/index.d.ts",
  "scripts": {
    "build": "vite build && api-extractor run --local",
    "test": "npm run lint && npm run test:spec",
    "test:spec": "vitest run",
    "postversion": "npm run build",
    "lint": "npm run lint:ts && npm run lint:oxlint && npm run format:check",
    "lint:ts": "tsc --noEmit",
    "lint:oxlint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tanimodori/viteburner.git"
  },
  "keywords": [
    "bitburner",
    "vite",
    "vite-plugin"
  ],
  "author": "Tanimodori",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Tanimodori/viteburner/issues"
  },
  "homepage": "https://github.com/Tanimodori/viteburner#readme",
  "devDependencies": {
    "@microsoft/api-extractor": "~7.33.6",
    "@types/estree": "^1.0.0",
    "@types/micromatch": "^4.0.2",
    "@types/node": "^18.14.1",
    "@viteburner/bb-ws-server": "workspace:*",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "rollup": "^3.30.0",
    "typescript": "^4.9.5",
    "vite": "^4.1.4",
    "vite-plugin-dts": "2.0.2",
    "vitest": "^0.34.6"
  },
  "dependencies": {
    "@types/ws": "^8.5.4",
    "acorn": "^8.8.2",
    "chokidar": "^3.5.3",
    "fast-glob": "^3.2.12",
    "magic-string": "^0.30.0",
    "micromatch": "^4.0.5",
    "pathe": "^1.1.0",
    "picocolors": "^1.0.0",
    "unconfig": "^0.3.7",
    "ws": "^8.12.1",
    "zod": "^3.20.6"
  },
  "peerDependencies": {
    "vite": "^3.0.0 || ^4.0.0"
  }
}
