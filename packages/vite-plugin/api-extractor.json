{
  "$schema": "https://developer.microsoft.com/json-schemas/api-extractor/v7/api-extractor.schema.json",
  "projectFolder": ".",
  "mainEntryPointFilePath": "<projectFolder>/dist/typings-tmp/index.d.ts",
  // These are the packages this package ships code from rather than depends on, so their declarations
  // have to be inlined too: @viteburner/bb-ws-server is bundled into dist (see the external list in vite.config.ts),
  // and rollup is where the public `SourceMap` type comes from — it is a devDependency, so a consumer
  // reading `dist/typings/index.d.ts` could not resolve it.
  "bundledPackages": ["@viteburner/bb-ws-server", "rollup"],
  "apiReport": {
    "enabled": false
  },
  "docModel": {
    "enabled": false
  },
  "dtsRollup": {
    "enabled": true,
    "publicTrimmedFilePath": "<projectFolder>/dist/typings/index.d.ts",
    // Disabled: the default is dist/<unscopedPackageName>.d.ts, which would ship a second copy.
    "untrimmedFilePath": ""
  },
  "tsdocMetadata": {
    "enabled": false
  },
  "messages": {
    "compilerMessageReporting": {
      "default": {
        "logLevel": "warning"
      }
    },
    "extractorMessageReporting": {
      "default": {
        "logLevel": "warning"
      },
      // Every declaration here carries a prose comment, not a TSDoc release tag.
      "ae-missing-release-tag": {
        "logLevel": "none"
      },
      // The session's services (and the SourceMap type it carries) are reachable from the exported
      // `Session` without being exported themselves: the plugin inlines them instead of publishing the
      // daemon's internals as named types, which is what these notices report.
      "ae-forgotten-export": {
        "logLevel": "none"
      }
    },
    "tsdocMessageReporting": {
      "default": {
        "logLevel": "none"
      }
    }
  }
}
