{
  "name": "@viteburner/bb-ws-server",
  "version": "0.1.0",
  "private": true,
  "description": "WebSocket server speaking the Bitburner Remote API protocol, with a WsManager that drives it.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "typings": "dist/index.d.ts",
  "scripts": {
    "build": "vite build",
    "test": "npm run lint && npm run test:spec",
    "test:spec": "vitest run",
    "postversion": "npm run build",
    "lint": "npm run lint:ts && npm run lint:oxlint && npm run format:check",
    "lint:ts": "tsc --noEmit",
    "lint:oxlint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tanimodori/viteburner.git"
  },
  "keywords": [
    "bitburner",
    "websocket"
  ],
  "author": "Tanimodori",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Tanimodori/viteburner/issues"
  },
  "homepage": "https://github.com/Tanimodori/viteburner#readme",
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.4",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.5.4",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-dts": "5.1.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "ws": "^8.12.1",
    "zod": "^4.6.7"
  }
}
