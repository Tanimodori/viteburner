{
  "name": "@viteburner/bb-ws-server",
  "version": "0.1.0",
  "private": true,
  "description": "WebSocket server speaking the Bitburner Remote API protocol, with a WsManager that drives it.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/typings/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "typings": "dist/typings/index.d.ts",
  "scripts": {
    "build": "vite build",
    "test": "npm run lint && npm run test:spec",
    "test:spec": "vitest run",
    "postversion": "npm run build",
    "lint": "npm run lint:ts && npm run lint:oxlint && npm run format:check",
    "lint:ts": "tsc --noEmit",
    "lint:oxlint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tanimodori/viteburner.git"
  },
  "keywords": [
    "bitburner",
    "websocket"
  ],
  "author": "Tanimodori",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Tanimodori/viteburner/issues"
  },
  "homepage": "https://github.com/Tanimodori/viteburner#readme",
  "devDependencies": {
    "@types/node": "^18.14.1",
    "@types/ws": "^8.5.4",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^4.9.5",
    "vite": "^4.1.4",
    "vite-plugin-dts": "2.0.2",
    "vitest": "^0.34.6"
  },
  "dependencies": {
    "ws": "^8.12.1",
    "zod": "^3.20.6"
  }
}
