{
  "plugins": ["eslint", "typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "es2021": true,
    "node": true,
    "browser": false
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/.rush/**",
    "**/NetscriptDefinitions.d.ts",
    "**/bin/**",
    "**/test/.cache/**",
    "**/test/.tmp/**"
  ],
  "rules": {
    "no-constant-condition": "off",
    "typescript/no-explicit-any": "warn"
  }
}
