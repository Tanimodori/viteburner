{
  "name": "viteburner-config-test",
  "version": "0.0.1",
  "private": true,
  "description": "Config suite for viteburner: every way of writing the config is loaded through a real vite dev server, and the resolved config on the server is checked from the outside.",
  "homepage": "https://github.com/Tanimodori/viteburner#readme",
  "bugs": {
    "url": "https://github.com/Tanimodori/viteburner/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tanimodori/viteburner.git"
  },
  "license": "MIT",
  "author": "Tanimodori",
  "type": "module",
  "scripts": {
    "build": "npm run typecheck",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "npm run lint:ts && npm run lint:oxlint && npm run format:check",
    "lint:ts": "tsc --noEmit",
    "lint:oxlint": "oxlint",
    "test": "npm run test:config",
    "test:config": "vitest run",
    "test:config:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^18.14.1",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^4.9.5",
    "vite": "^4.1.4",
    "viteburner": "workspace:*",
    "vitest": "^0.34.6"
  },
  "engines": {
    "node": ">=24"
  }
}
