{
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "Node",
    "target": "esnext",
    "lib": ["esnext", "dom"],
    "strict": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "types": ["node"]
  },
  "include": ["test/**/*.ts", "vitest.config.ts"],
  "exclude": ["test/.cache", "test/.tmp"]
}
