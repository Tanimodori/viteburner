{
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "Node",
    "target": "esnext",
    "lib": ["esnext", "dom"],
    "strict": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "types": ["node"]
  },
  // The fixture project's `src/**` is deliberately out of reach: it imports `@ns`, which only
  // resolves through the fixture's own tsconfig once the CLI has downloaded the game's definitions,
  // and its correctness is judged by the E2E run, not by tsc. The fixture's `vite.config.ts` is the
  // one fixture file checked here, because it uses the published `ViteBurnerUserConfig` type.
  "include": ["test/**/*.ts", "vitest.config.ts", "src/vite.config.ts"],
  "exclude": ["test/.cache", "test/.tmp"]
}
