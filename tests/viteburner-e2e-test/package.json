{
  "name": "viteburner-e2e-test",
  "version": "0.0.1",
  "private": true,
  "description": "End-to-end acceptance suite for the viteburner CLI: a real Bitburner build in a real browser connects to the built CLI over the game's Remote API, and vitest judges the sync pipeline from the outside.",
  "homepage": "https://github.com/Tanimodori/viteburner#readme",
  "bugs": {
    "url": "https://github.com/Tanimodori/viteburner/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tanimodori/viteburner.git"
  },
  "license": "MIT",
  "author": "Tanimodori",
  "type": "module",
  "scripts": {
    "build": "npm run typecheck",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "npm run lint:ts && npm run lint:oxlint && npm run format:check",
    "lint:ts": "tsc --noEmit",
    "lint:oxlint": "oxlint",
    "setup": "npm run setup:browser && npm run setup:game",
    "setup:browser": "playwright install chromium",
    "setup:game": "tsx test/local/setup-game.ts",
    "test": "npm run test:e2e",
    "test:e2e": "vitest run",
    "test:e2e:live": "vitest run --mode live",
    "test:e2e:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^18.14.1",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^4.9.5",
    "vite": "^4.1.4",
    "viteburner": "workspace:*",
    "vitest": "^0.34.6"
  },
  "engines": {
    "node": ">=24"
  }
}
